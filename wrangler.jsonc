{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mc-next",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/static/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mc-next",
      "database_id": "14b029a2-cd97-4337-a0a7-3dc319f9c35d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "mc-next-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RCON",
        "class_name": "RconDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RconDO"]
    }
  ],
  "vars": {
    "APP_NAME": "Westworld西域之光",
    "TOKEN_TTL_HOURS": "168",
    "TURNSTILE_ENABLED": "false",
    "MICROSOFT_OAUTH_ENABLED": "false",
    "AI_ENABLED": "false",
    "RCON_ENABLED": "false",
    "MONITOR_ENABLED": "false"
  }
}